{
  "name": "akcelport-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Akcelport Industries backoffice: edits the website content in PostgreSQL and publishes the static site.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/src/index.ts",
    "migrate": "tsx server/src/cli/migrate.ts",
    "seed": "tsx server/src/cli/seed.ts",
    "create-admin": "tsx server/src/cli/create-admin.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.14.1",
    "tsx": "^4.19.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.70.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.552.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
