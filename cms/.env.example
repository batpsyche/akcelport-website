# Akcelport CMS configuration. Copy to .env (never commit .env).

# PostgreSQL connection string (required).
DATABASE_URL=postgres://akcelport:change-me@localhost:5432/akcelport_cms

# Secret used to sign the session cookie (required, at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Port of the backoffice (API + admin UI).
PORT=3000
# Port on which the CMS serves the currently published site (root path), for preview and local use.
SITE_PORT=4174

# Where uploaded photos and PDFs live (mirrors the website's public/ layout: img/..., downloads/...).
MEDIA_DIR=./data/media
# Where publishes are built: releases/<id>/, current -> releases/<id>, preview/.
PUBLISH_DIR=./data/publish
# Root of the website repository (scripts/build.mjs, src/, public/, content/). Defaults to the parent directory of cms/.
# SITE_ROOT=..
# Origin used for canonical, sitemap and Open Graph URLs in the published site. Defaults to siteUrl in Site settings.
# SITE_URL=https://www.akcelport.com

# How many past releases to keep for rollback.
PUBLISH_KEEP=5

# Set to 1 when the CMS is served over HTTPS (marks the session cookie Secure). Defaults to 1 when NODE_ENV=production.
# SESSION_SECURE=1
# Set to 1 when behind a reverse proxy that sets X-Forwarded-For (used for rate limiting and the audit log).
# TRUST_PROXY=1

# Session lifetime: idle timeout in hours and absolute maximum in days.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# Upload limits in megabytes.
UPLOAD_IMAGE_MAX_MB=10
UPLOAD_PDF_MAX_MB=25

# Used only by `npm run create-admin` when no password is typed interactively (for example in Docker).
# ADMIN_PASSWORD=
